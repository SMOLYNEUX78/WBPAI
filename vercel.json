{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "api/lookupAddress.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/baselineExport.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/lookupAddress",
      "dest": "/api/lookupAddress"
    },
    {
      "src": "/api/baselineExport",
      "dest": "/api/baselineExport"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "headers": { "Cache-Control": "no-store" },
      "dest": "/index.html"
    }
  ]
}

